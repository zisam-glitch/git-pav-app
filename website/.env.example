# =============================================================================
# PavDental Website Environment Template (.env.example)
# Copy to .env and configure values as needed.
# =============================================================================

# Admin Dashboard API Endpoint (Backend)
VITE_API_BASE_URL="http://localhost:3000"

# The app's backend (accounts). The /verify-email and /reset-password pages
# that email links open call it directly. Add this site's origin to the
# backend's ALLOWED_ORIGINS. In production, e.g. https://api.pavdental.com
VITE_APP_API_URL="http://localhost:3000"

# Google Analytics 4 Measurement ID (C-15). Loaded only after cookie consent.
VITE_GA4_ID="G-KZVKDLY449"
