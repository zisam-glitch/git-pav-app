{
  "expo": {
    "name": "Pav Dental",
    "slug": "pavdental",
    "version": "1.0.0",
    "scheme": "pavdental",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pavdental.app",
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.pavdental.app"
        ]
      },
      "associatedDomains": [
        "applinks:pavdental.com",
        "applinks:staging.pavdental.com"
      ],
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.pavdental.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "pavdental.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "pavdental.com",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "staging.pavdental.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "staging.pavdental.com",
              "pathPrefix": "/verify-email"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#0D9488"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0D9488"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.pavdental.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pav Dental uses your location to check whether our dental van can visit you and to fill in your postcode. If you drive a Pav Dental van, it also shares the van's position with that day's patients during your shift.",
          "locationAlwaysAndWhenInUsePermission": "During a van shift, Pav Dental shares the van's position with that day's patients even when the app is in the background, so their arrival times stay accurate. It stops when you end your shift.",
          "locationAlwaysPermission": "During a van shift, Pav Dental shares the van's position with that day's patients even when the app is in the background, so their arrival times stay accurate. It stops when you end your shift.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pav Dental needs photo library access so you can attach dental photos and clinical documents.",
          "cameraPermission": "Pav Dental uses the camera for video consultations with your dentist, and so you can take photos of your teeth to send to them.",
          "microphonePermission": "Pav Dental uses the microphone so your dentist can hear you during a video consultation."
        }
      ],
      [
        "@daily-co/config-plugin-rn-daily-js",
        {
          "enableCamera": true,
          "enableMicrophone": true,
          "enableScreenShare": false,
          "cameraPermission": "Pav Dental uses the camera for video consultations with your dentist, and so you can take photos of your teeth to send to them.",
          "microphonePermission": "Pav Dental uses the microphone so your dentist can hear you during a video consultation."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Pav Dental account"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "growriva",
          "project": "pav-mobile-app"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
